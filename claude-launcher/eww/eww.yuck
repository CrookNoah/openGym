;; claude-launcher — project picker widget
;;
;; All list state (query, selection, formatting) is computed by the shell and
;; arrives as one JSON object, so the yuck stays declarative and there is a
;; single place where "what is selected" is decided.

(deflisten pdata
  :initial '{"query":"","selected":0,"count":0,"items":[]}'
  "claude-launcher feed")

(defwidget cl-row [item]
  (eventbox :class {item.cls}
            :cursor "pointer"
            :onclick "claude-launcher ctl open-index ${item.index}"
            :onmiddleclick "claude-launcher ctl open-index ${item.index} --fresh"
    (box :class "row-inner" :space-evenly false :spacing 12
      (label :class "glyph ${item.lang_class}" :text {item.lang})
      (box :orientation "vertical" :space-evenly false :hexpand true :valign "center"
        (label :class "name" :halign "start" :limit-width 30 :text {item.name})
        (label :class "meta" :halign "start" :limit-width 40
               :visible {item.meta != ""} :text {item.meta}))
      (label :class "badge" :visible {item.badge != ""} :text {item.badge})
      (label :class "ago"   :visible {item.ago   != ""} :text {item.ago}))))

(defwidget cl-launcher []
  (box :class "cl-root" :orientation "vertical" :space-evenly false
    (box :class "cl-head" :space-evenly false :spacing 10
      (label :class "mark"  :text "✻")
      (label :class "title" :text "Launch Claude")
      (box :hexpand true)
      (label :class "count" :text "${pdata.count} ${pdata.count == 1 ? 'project' : 'projects'}"))

    (box :class "cl-search" :space-evenly false :spacing 10
      (label :class "search-icon" :text "⌕")
      (input :class "search-input" :hexpand true
             :onchange "claude-launcher ctl query {}"
             :onaccept "claude-launcher ctl open"))

    ;; List height — raise it if you keep more than a dozen projects around.
    (scroll :class "cl-scroll" :vscroll true :hscroll false :height 340
      (box :class "cl-list" :orientation "vertical" :space-evenly false :spacing 2
        (for item in {pdata.items}
          (cl-row :item item))))

    (box :class "cl-foot" :space-evenly false :spacing 14
      (label :class "key" :text "↑↓ nav")
      (label :class "key" :text "↵ open")
      (label :class "key" :text "⇧↵ fresh")
      (label :class "key" :text "esc close")
      (box :hexpand true)
      (label :class "brand" :text "omarchy"))))

(defwindow launcher
  :namespace "claude-launcher"
  :monitor 0
  :stacking "overlay"
  ;; eww >= 0.6 prefers :focusable "exclusive"; a bool still works there and is
  ;; the only form older builds accept.
  :focusable true
  ;; `anchor` is overridden at open time from config.toml; width is set here.
  :geometry (geometry :anchor "center" :width "440px")
  (cl-launcher))
